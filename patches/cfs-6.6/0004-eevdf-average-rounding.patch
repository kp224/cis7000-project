From 97abb2eb8f44c5aebef9094ffc5f13285a45efac Mon Sep 17 00:00:00 2001
From: Kasra Panahi <kasrapanahi2@gmail.com>
Date: Sun, 11 Oct 2026 15:17:55 -0400
Subject: [PATCH] Revert EEVDF average rounding

Reverts upstream 650cad561cce04b62a8c8e0446b685ef171bc3bb.
Intermediate step in the complete CFS restoration; not for benchmarking.
---
 kernel/sched/fair.c | 10 +---------
 1 file changed, 1 insertion(+), 9 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index ef7490c..7d73652 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -664,10 +664,6 @@ void avg_vruntime_update(struct cfs_rq *cfs_rq, s64 delta)
 	cfs_rq->avg_vruntime -= cfs_rq->avg_load * delta;
 }
 
-/*
- * Specifically: avg_runtime() + 0 must result in entity_eligible() := true
- * For this to be so, the result of this function must have a left bias.
- */
 u64 avg_vruntime(struct cfs_rq *cfs_rq)
 {
 	struct sched_entity *curr = cfs_rq->curr;
@@ -681,12 +677,8 @@ u64 avg_vruntime(struct cfs_rq *cfs_rq)
 		load += weight;
 	}
 
-	if (load) {
-		/* sign flips effective floor / ceil */
-		if (avg < 0)
-			avg -= (load - 1);
+	if (load)
 		avg = div_s64(avg, load);
-	}
 
 	return cfs_rq->min_vruntime + avg;
 }

From 3b62020578f49419596451c24b198a8425bbc014 Mon Sep 17 00:00:00 2001
From: Kasra Panahi <kasrapanahi2@gmail.com>
Date: Sun, 11 Oct 2026 15:17:55 -0400
Subject: [PATCH] Remove EEVDF run-to-parity

Reverts upstream 63304558ba5dcaaff9e052ee43cfdcc7f9c29e85.
Intermediate step in the complete CFS restoration; not for benchmarking.
---
 kernel/sched/fair.c     | 12 ------------
 kernel/sched/features.h |  1 -
 2 files changed, 13 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 2cc180a..5b68862 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -873,13 +873,6 @@ static struct sched_entity *pick_eevdf(struct cfs_rq *cfs_rq)
 	if (curr && (!curr->on_rq || !entity_eligible(cfs_rq, curr)))
 		curr = NULL;
 
-	/*
-	 * Once selected, run a task until it either becomes non-eligible or
-	 * until it gets a new slice. See the HACK in set_next_entity().
-	 */
-	if (sched_feat(RUN_TO_PARITY) && curr && curr->vlag == curr->deadline)
-		return curr;
-
 	while (node) {
 		struct sched_entity *se = __node_2_se(node);
 
@@ -5175,11 +5168,6 @@ set_next_entity(struct cfs_rq *cfs_rq, struct sched_entity *se)
 		update_stats_wait_end_fair(cfs_rq, se);
 		__dequeue_entity(cfs_rq, se);
 		update_load_avg(cfs_rq, se, UPDATE_TG);
-		/*
-		 * HACK, stash a copy of deadline at the point of pick in vlag,
-		 * which isn't used until dequeue.
-		 */
-		se->vlag = se->deadline;
 	}
 
 	update_stats_curr_start(cfs_rq, se);
diff --git a/kernel/sched/features.h b/kernel/sched/features.h
index f770168..61bcbf5 100644
--- a/kernel/sched/features.h
+++ b/kernel/sched/features.h
@@ -6,7 +6,6 @@
  */
 SCHED_FEAT(PLACE_LAG, true)
 SCHED_FEAT(PLACE_DEADLINE_INITIAL, true)
-SCHED_FEAT(RUN_TO_PARITY, true)
 
 /*
  * Prefer to schedule the task we woke last (assuming it failed

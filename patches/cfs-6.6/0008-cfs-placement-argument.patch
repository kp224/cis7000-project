From 34f1df808c2f8961170c7e6d28c11c2932408f38 Mon Sep 17 00:00:00 2001
From: Kasra Panahi <kasrapanahi2@gmail.com>
Date: Sun, 11 Oct 2026 15:17:56 -0400
Subject: [PATCH] Restore CFS placement argument

Reverts upstream d07f09a1f99cabbc86bc5c97d962eb8a466106b5.
Intermediate step in the complete CFS restoration; not for benchmarking.
---
 kernel/sched/fair.c  | 10 +++++-----
 kernel/sched/sched.h |  1 -
 2 files changed, 5 insertions(+), 6 deletions(-)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 5b68862..e23e787 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -4910,7 +4910,7 @@ static inline void update_misfit_status(struct task_struct *p, struct rq *rq) {}
 #endif /* CONFIG_SMP */
 
 static void
-place_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
+place_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int initial)
 {
 	u64 vslice = calc_delta_fair(se->slice, se);
 	u64 vruntime = avg_vruntime(cfs_rq);
@@ -4999,7 +4999,7 @@ place_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
 	 * on average, halfway through their slice, as such start tasks
 	 * off with half a slice to ease into the competition.
 	 */
-	if (sched_feat(PLACE_DEADLINE_INITIAL) && (flags & ENQUEUE_INITIAL))
+	if (sched_feat(PLACE_DEADLINE_INITIAL) && initial)
 		vslice /= 2;
 
 	/*
@@ -5023,7 +5023,7 @@ enqueue_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
 	 * update_curr().
 	 */
 	if (curr)
-		place_entity(cfs_rq, se, flags);
+		place_entity(cfs_rq, se, 0);
 
 	update_curr(cfs_rq);
 
@@ -5050,7 +5050,7 @@ enqueue_entity(struct cfs_rq *cfs_rq, struct sched_entity *se, int flags)
 	 * we can place the entity.
 	 */
 	if (!curr)
-		place_entity(cfs_rq, se, flags);
+		place_entity(cfs_rq, se, 0);
 
 	account_entity_enqueue(cfs_rq, se);
 
@@ -12353,7 +12353,7 @@ static void task_fork_fair(struct task_struct *p)
 	curr = cfs_rq->curr;
 	if (curr)
 		update_curr(cfs_rq);
-	place_entity(cfs_rq, se, ENQUEUE_INITIAL);
+	place_entity(cfs_rq, se, 1);
 	rq_unlock(rq, &rf);
 }
 
diff --git a/kernel/sched/sched.h b/kernel/sched/sched.h
index 0484627..4ce0f5f 100644
--- a/kernel/sched/sched.h
+++ b/kernel/sched/sched.h
@@ -2218,7 +2218,6 @@ extern const u32		sched_prio_to_wmult[40];
 #else
 #define ENQUEUE_MIGRATED	0x00
 #endif
-#define ENQUEUE_INITIAL		0x80
 
 #define RETRY_TASK		((void *)-1UL)
 
